generator client {
  provider = "prisma-client-js"
  output   = "../../apps/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum Goal {
  weight_loss
  weight_gain
  maintenance
}

enum RestrictionType {
  allergy
  intolerance
  preference
}

enum MealSlot {
  breakfast
  lunch
  dinner
  snack
}

enum MealPlanStatus {
  draft
  active
  completed
}

enum ActivityIntensity {
  low
  moderate
  high
}

enum NutritionLogSource {
  meal_plan
  manual
  search
  recipe
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile            UserProfile?
  restrictions       DietaryRestriction[]
  refreshTokens      RefreshToken[]
  weightLogs         WeightLog[]
  activityLogs       ActivityLog[]
  mealPlans          MealPlan[]
  dailyNutritionLogs DailyNutritionLog[]
  recipes            Recipe[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserProfile {
  userId         String        @id @map("user_id")
  sex            Sex
  dateOfBirth    DateTime      @map("date_of_birth") @db.Date
  heightCm       Decimal       @map("height_cm")
  activityLevel  ActivityLevel @map("activity_level")
  goal           Goal
  targetWeightKg Decimal?      @map("target_weight_kg")
  weeklyRateKg   Decimal?      @map("weekly_rate_kg")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model DietaryRestriction {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  type      RestrictionType
  value     String
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("dietary_restrictions")
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  weightKg  Decimal  @map("weight_kg")
  loggedAt  DateTime @map("logged_at")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("weight_logs")
}

model ActivityLog {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  activityType    String            @map("activity_type")
  durationMinutes Int               @map("duration_minutes")
  caloriesBurned  Decimal?          @map("calories_burned")
  intensity       ActivityIntensity
  loggedAt        DateTime          @map("logged_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("activity_logs")
}

/// The app's own curated ingredient dataset — every nutrition value is
/// defined per one `baseUnit` (almost always "100g"; a genuinely discrete
/// food like egg instead defines baseUnit as "1 medium egg" with its own
/// per-egg values, so a recipe's `amount` multiplier never needs unit
/// conversion math). `defaultServingWeightGrams` is the gram-equivalent of
/// one baseUnit, always populated (100 for the 100g default).
model FoodItem {
  foodId                    Int      @id @default(autoincrement()) @map("food_id")
  name                      String   @unique
  /// The brand/manufacturer this nutrition data is specific to (e.g. "Tnuva",
  /// "Osem") — null for generic, brand-agnostic entries. Different brands of
  /// what's otherwise the same food can have meaningfully different
  /// nutrition, so this is informational display, not just a label.
  company                   String?
  category                  String
  calories                  Decimal
  proteinG                  Decimal  @map("protein_g")
  carbsG                    Decimal  @map("carbs_g")
  fatG                      Decimal  @map("fat_g")
  saturatedFatG             Decimal  @map("saturated_fat_g")
  sugarG                    Decimal  @map("sugar_g")
  sodiumMg                  Decimal  @map("sodium_mg")
  baseUnit                  String   @default("100g") @map("base_unit")
  defaultServingWeightGrams Decimal  @default(100) @map("default_serving_weight_grams")
  createdAt                 DateTime @default(now()) @map("created_at")

  mealPlanItems      MealPlanItem[]
  dailyNutritionLogs DailyNutritionLog[]
  recipeIngredients  RecipeIngredient[]

  @@map("food_items")
}

/// A user's own reusable composed meal — a name plus a list of ingredients,
/// each an existing FoodItem scaled by `amount` (identical "multiplier of
/// that food's own baseUnit" semantics MealPlanItem and DailyNutritionLog
/// already use, e.g. amount=2 against a FoodItem whose baseUnit is "1 medium
/// egg" means "2 eggs"). No separate yield/serving-count field: 1x a Recipe
/// is defined as the sum of all its ingredients at their given amounts, so
/// there's exactly one scaling mechanism, not two.
model Recipe {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  // Default is a safety net for pre-migration rows only (migrate deploy runs
  // unattended on every build) — every API-created recipe passes this
  // explicitly, never relying on the fallback.
  mealSlot  MealSlot @default(lunch) @map("meal_slot")
  createdAt DateTime @default(now()) @map("created_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  mealPlanItems      MealPlanItem[]
  dailyNutritionLogs DailyNutritionLog[]

  @@index([userId])
  @@index([userId, mealSlot])
  @@map("recipes")
}

model RecipeIngredient {
  id         String  @id @default(uuid())
  recipeId   String  @map("recipe_id")
  foodItemId Int     @map("food_item_id")
  amount     Decimal
  sortOrder  Int     @map("sort_order")

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [foodId])

  @@index([recipeId])
  @@map("recipe_ingredients")
}

model MealPlan {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  date           DateTime       @db.Date
  goalSnapshot   Goal           @map("goal_snapshot")
  calorieTarget  Decimal        @map("calorie_target")
  proteinTargetG Decimal        @map("protein_target_g")
  carbsTargetG   Decimal        @map("carbs_target_g")
  fatTargetG     Decimal        @map("fat_target_g")
  status         MealPlanStatus @default(draft)
  createdAt      DateTime       @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealPlanItem[]

  @@index([userId, date])
  @@map("meal_plans")
}

model MealPlanItem {
  id         String   @id @default(uuid())
  mealPlanId String   @map("meal_plan_id")
  // Exactly one of foodItemId/recipeId is set per item — enforced by
  // persist() being the single write path, not a DB constraint (mirrors how
  // DailyNutritionLog's own nullable dual-FK below is already governed by
  // application logic, not the schema).
  foodItemId Int?     @map("food_item_id")
  recipeId   String?  @map("recipe_id")
  mealSlot   MealSlot @map("meal_slot")
  servings   Decimal
  calories   Decimal
  proteinG   Decimal  @map("protein_g")
  carbsG     Decimal  @map("carbs_g")
  fatG       Decimal  @map("fat_g")
  sortOrder  Int      @map("sort_order")

  mealPlan MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [foodId])
  recipe   Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  dailyNutritionLogs DailyNutritionLog[]

  @@index([mealPlanId])
  @@map("meal_plan_items")
}

model DailyNutritionLog {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  date           DateTime           @db.Date
  foodItemId     Int?               @map("food_item_id")
  mealPlanItemId String?            @map("meal_plan_item_id")
  recipeId       String?            @map("recipe_id")
  servings       Decimal
  calories       Decimal
  proteinG       Decimal            @map("protein_g")
  carbsG         Decimal            @map("carbs_g")
  fatG           Decimal            @map("fat_g")
  source         NutritionLogSource
  loggedAt       DateTime           @map("logged_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem     FoodItem?     @relation(fields: [foodItemId], references: [foodId])
  mealPlanItem MealPlanItem? @relation(fields: [mealPlanItemId], references: [id])
  recipe       Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("daily_nutrition_logs")
}
