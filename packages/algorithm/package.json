{
  "name": "@meal-planning/algorithm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist-cjs/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist-cjs/index.js && node -e \"require('fs').writeFileSync('dist-cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured yet'",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts"
  },
  "dependencies": {
    "@meal-planning/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@meal-planning/config": "workspace:*",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
